# =============================================================================
# AI Ops Platform — 环境变量样例
#
# 用法：cp .env.example .env，填入真实值。
# .env 已被 .gitignore 排除，不会提交。docker compose 通过 env_file 自动加载。
#
# config.yaml 里所有 ${ENV_NAME} 占位符都在运行时从这些变量插值。
# 未设置的变量会被替换为空字符串（启动日志会给出警告清单）。
# =============================================================================

# --- 平台自身 ----------------------------------------------------------------
# Web 工作台 / API 访问令牌（强烈建议设置；留空则接口不鉴权，仅限内网单机）
AIOPS_API_TOKEN=

# 允许在非回环地址（如 host=0.0.0.0）且不设 apiToken 时启动（仅限隔离内网！启动会打 warn）。
# 不设此项 + host=0.0.0.0 + apiToken 为空 → 服务拒绝启动（安全闸）。
AIOPS_ALLOW_INSECURE_NO_AUTH=true

# Webhook 共享密钥（Alertmanager/飞书/企微 推送告警时校验来源；留空不校验）
AIOPS_WEBHOOK_SECRET=

# --- 大模型 API Key（按 config.yaml 里实际启用的 provider 填写）----------------
# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 阿里通义千问 DashScope（https://dashscope.aliyuncs.com）
DASHSCOPE_API_KEY=

# 本地/内网推理服务（通常无需 key，可填任意占位值）
LOCAL_LLM_API_KEY=

# --- Elasticsearch -----------------------------------------------------------
# 生产 ES（建议只读账号）
ES_PROD_USERNAME=
ES_PROD_PASSWORD=

# 开发/测试 ES
ES_DEV_USERNAME=
ES_DEV_PASSWORD=

# --- Prometheus（无认证则留空）------------------------------------------------
PROM_USERNAME=
PROM_PASSWORD=

# --- SSH 主机（严格只读命令白名单，详见 config.yaml security.readonly）----------
# Dev 主机：password 与 privateKeyPath 二选一，推荐密钥
SSH_DEV_USER=
SSH_DEV_PASSWORD=
SSH_DEV_KEY_PATH=
SSH_DEV_KEY_PASSPHRASE=

# 应用服务器（示例，默认 disabled）
SSH_APP_USER=
SSH_APP_PASSWORD=

# --- 日报推送（可选）----------------------------------------------------------
# 飞书群机器人 webhook（alerts.scheduler.reportWebhookUrl）
FEISHU_BOT_WEBHOOK=
