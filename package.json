{
  "name": "ai-ops-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven read-only operations diagnosis platform for log and metric troubleshooting",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server/src/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "all:build": "npm run build && npm run web:build",
    "doctor": "node --disable-warning=ExperimentalWarning dist/scripts/doctor.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ssh2": "^1.16.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
